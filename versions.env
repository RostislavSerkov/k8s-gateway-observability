# Единая точка управления версиями всех компонентов решения.
# Файл подключается всеми скриптами (scripts/lib.sh). Меняйте версии только здесь.

# --- Kubernetes (kubeadm, kubelet, kubectl из pkgs.k8s.io) ---
KUBERNETES_VERSION="1.36.5"
KUBERNETES_MINOR="v1.36"

# --- Сеть кластера ---
CALICO_VERSION="v3.32.2"
POD_CIDR="10.244.0.0/16"
SERVICE_CIDR="10.96.0.0/12"

# --- Инструменты ---
HELM_VERSION="v3.22.0"

# --- Gateway API: Envoy Gateway (поставляет CRD Gateway API v1.6.1) ---
ENVOY_GATEWAY_VERSION="v1.9.2"
GATEWAY_API_VERSION="v1.6.1"

# --- Мониторинг ---
KUBE_PROMETHEUS_STACK_VERSION="91.9.0"

# --- Внешний доступ к Gateway (NodePort на ноде) ---
GATEWAY_HTTP_NODEPORT="30080"
GATEWAY_HTTPS_NODEPORT="30443"

# --- Доменная зона демо-стенда (резолвится через --resolve / /etc/hosts) ---
DEMO_DOMAIN="demo.local"
