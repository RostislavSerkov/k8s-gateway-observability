    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (version) (rate(nginx_http_requests_total{namespace=\"demo\"}[1m]))",
     "legendFormat": "{{version}}",
     "range": true
